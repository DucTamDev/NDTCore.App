diff --git a/src/features/printer/detection/LanguageDetectionService.ts b/src/features/printer/detection/LanguageDetectionService.ts
new file mode 100644
index 0000000..a3b97e2
--- /dev/null
+++ b/src/features/printer/detection/LanguageDetectionService.ts
@@ -0,0 +1,170 @@
+import type { Unsubscribe } from '../adapters/IPrinterAdapter';
+import { ConnectionType } from '../models/printer/ConnectionType';
+import { LanguageSelection, PrintLanguage, type PrinterLanguage } from '../models/printer/PrinterLanguage';
+import type { Printer } from '../models/printer/Printer';
+import { PrinterErrorCode, errorCodeOf, type PrinterError } from '../errors/PrinterError';
+import { PrinterLogger } from '../logging/PrinterLogger';
+import { getPrintLanguage } from '../languages/getPrintLanguage';
+import { PrinterConnectionService } from '../connection/PrinterConnectionService';
+import { canPrintKind } from '../forms/addPrinter/printerRules';
+import { createPrinterLanguage } from '../management/createPrinterDraft';
+
+/** Máy TSPL trả lời lệnh dò trong vài trăm mili giây; quá hạn coi như không phải ngôn ngữ đó. */
+const IDENTIFY_TIMEOUT_MS = 1000;
+
+/** TSPL có lệnh dò là phép thử thật nên chạy trước; ESC/POS chỉ xác nhận yếu nên để cuối. */
+const CANDIDATE_ORDER: PrintLanguage[] = [PrintLanguage.Tspl, PrintLanguage.EscPos];
+
+export const LanguageDetectionStage = {
+  Connecting: 'Connecting',
+  Identifying: 'Identifying',
+  Detected: 'Detected',
+  Unknown: 'Unknown',
+  Error: 'Error',
+} as const;
+
+export type LanguageDetectionStage = (typeof LanguageDetectionStage)[keyof typeof LanguageDetectionStage];
+
+/** Một cập nhật trong lúc dò ngôn ngữ của máy in. */
+export type LanguageDetectionEvent =
+  | { stage: typeof LanguageDetectionStage.Connecting }
+  | { stage: typeof LanguageDetectionStage.Identifying; language: PrintLanguage }
+  | { stage: typeof LanguageDetectionStage.Detected; language: PrinterLanguage }
+  | { stage: typeof LanguageDetectionStage.Unknown }
+  | { stage: typeof LanguageDetectionStage.Error; error: PrinterError };
+
+/** Máy in cần dò ngôn ngữ. */
+export interface LanguageDetectionInput {
+  /** Bản nháp đủ field; chỉ dùng `id`, `kind` và `connection`. */
+  draftPrinter: Printer;
+}
+
+type DetectionConnectionService = Pick<typeof PrinterConnectionService, 'connect' | 'disconnect' | 'send' | 'read'>;
+
+/** Những thứ một lần dò cần, gom lại để tách các bước ra hàm riêng. */
+interface DetectionContext {
+  printer: Printer;
+
+  connectionService: DetectionConnectionService;
+
+  onEvent: (event: LanguageDetectionEvent) => void;
+
+  isCancelled: () => boolean;
+}
+
+/**
+ * Ngôn ngữ có lệnh dò thì máy phải trả lời. ESC/POS không có lệnh dò nên kết nối được qua Bluetooth/LAN là đủ;
+ * USB thì không, vì kết nối USB thành công với mọi máy.
+ */
+const confirmLanguage = async (context: DetectionContext, type: PrintLanguage): Promise<boolean> => {
+  const { printer, connectionService } = context;
+  const probe = getPrintLanguage(type).identifyProbe;
+
+  if (!probe) {
+    return printer.connection.type !== ConnectionType.Usb;
+  }
+
+  try {
+    await connectionService.send(printer.id, probe.command);
+    const response = await connectionService.read(printer.id, IDENTIFY_TIMEOUT_MS);
+    return response !== null && probe.matches(response);
+  } catch {
+    return false;
+  }
+};
+
+/** Thử lần lượt trên kết nối đã mở; `undefined` khi không ngôn ngữ nào khớp hoặc đã huỷ. */
+const findLanguage = async (
+  context: DetectionContext,
+  candidates: PrintLanguage[],
+): Promise<PrintLanguage | undefined> => {
+  const { printer } = context;
+
+  for (const type of candidates) {
+    if (context.isCancelled()) {
+      return undefined;
+    }
+
+    context.onEvent({ stage: LanguageDetectionStage.Identifying, language: type });
+
+    if (await confirmLanguage(context, type)) {
+      return type;
+    }
+
+    const connectionType = printer.connection.type;
+    PrinterLogger.detectionCandidateRejected({ printerId: printer.id, language: type, connectionType });
+  }
+
+  return undefined;
+};
+
+/** Dò ngôn ngữ của máy in mới trên một lần kết nối duy nhất. */
+export const createLanguageDetectionService = (
+  connectionService: DetectionConnectionService = PrinterConnectionService,
+) => {
+  const run = async (context: DetectionContext): Promise<void> => {
+    const { printer, onEvent, isCancelled } = context;
+    const logFields = { printerId: printer.id, connectionType: printer.connection.type };
+    const candidates = CANDIDATE_ORDER.filter((type) => canPrintKind(type, printer.kind));
+    const startedAt = Date.now();
+    const disconnectQuietly = (): Promise<void> => connectionService.disconnect(printer.id).catch(() => undefined);
+
+    PrinterLogger.detectionStarted({ ...logFields, candidates });
+    onEvent({ stage: LanguageDetectionStage.Connecting });
+
+    try {
+      await connectionService.connect(printer);
+    } catch (error) {
+      if (!isCancelled()) {
+        const failure = { code: PrinterErrorCode.PRINTER_CONNECTION_FAILED, message: 'Không thể kết nối tới máy in' };
+        onEvent({ stage: LanguageDetectionStage.Error, error: failure });
+        const errorCode = errorCodeOf(error);
+        PrinterLogger.detectionFailed({ ...logFields, errorCode, durationMs: Date.now() - startedAt });
+      }
+
+      return;
+    }
+
+    const detected = await findLanguage(context, candidates);
+
+    if (isCancelled()) {
+      await disconnectQuietly();
+      return;
+    }
+
+    const candidatesTried = detected ? candidates.slice(0, candidates.indexOf(detected) + 1) : candidates;
+    const durationMs = Date.now() - startedAt;
+
+    if (detected) {
+      const language = createPrinterLanguage(detected, LanguageSelection.Auto);
+      onEvent({ stage: LanguageDetectionStage.Detected, language });
+      PrinterLogger.languageDetected({ ...logFields, language: detected, candidatesTried, durationMs });
+      return;
+    }
+
+    await disconnectQuietly();
+    onEvent({ stage: LanguageDetectionStage.Unknown });
+    PrinterLogger.languageUnknown({ ...logFields, candidatesTried, durationMs });
+  };
+
+  /** Huỷ giữa chừng thì ngắt kết nối và không báo thêm sự kiện nào. */
+  const detect = (input: LanguageDetectionInput, onEvent: (event: LanguageDetectionEvent) => void): Unsubscribe => {
+    let cancelled = false;
+    const isCancelled = (): boolean => cancelled;
+    const guardedOnEvent = (event: LanguageDetectionEvent): void => {
+      if (!cancelled) {
+        onEvent(event);
+      }
+    };
+
+    run({ printer: input.draftPrinter, connectionService, onEvent: guardedOnEvent, isCancelled });
+
+    return () => {
+      cancelled = true;
+    };
+  };
+
+  return { detect };
+};
+
+export const LanguageDetectionService = createLanguageDetectionService();
diff --git a/src/features/printer/detection/__tests__/LanguageDetectionService.test.ts b/src/features/printer/detection/__tests__/LanguageDetectionService.test.ts
new file mode 100644
index 0000000..6851c57
--- /dev/null
+++ b/src/features/printer/detection/__tests__/LanguageDetectionService.test.ts
@@ -0,0 +1,191 @@
+import {
+  createLanguageDetectionService,
+  LanguageDetectionStage,
+  type LanguageDetectionEvent,
+} from '../LanguageDetectionService';
+import { ConnectionType } from '../../models/printer/ConnectionType';
+import { LanguageSelection, PrintLanguage, RasterSource, RenderMode } from '../../models/printer/PrinterLanguage';
+import { PrintKind } from '../../models/printer/PrintKind';
+import type { Printer } from '../../models/printer/Printer';
+import { PrinterErrorCode } from '../../errors/PrinterError';
+import { PrinterLogger } from '../../logging/PrinterLogger';
+import { makePrinter } from '../../testing/printerFixtures';
+import { makeMockConnectionService } from '../../testing/printerServiceTestKit';
+
+jest.mock('../../logging/PrinterLogger', () => ({
+  PrinterLogger: {
+    detectionStarted: jest.fn(),
+    detectionCandidateRejected: jest.fn(),
+    detectionFailed: jest.fn(),
+    languageDetected: jest.fn(),
+    languageUnknown: jest.fn(),
+  },
+}));
+
+const TSPL_REPLY = new Uint8Array([0x54, 0x53, 0x43]);
+
+const lanDraft: Printer = makePrinter({ name: 'Máy in mới' });
+
+const usbDraft: Printer = makePrinter({ connection: { type: ConnectionType.Usb, vendorId: 1155, productId: 22222 } });
+
+const isFinal = (event: LanguageDetectionEvent): boolean =>
+  event.stage === LanguageDetectionStage.Detected ||
+  event.stage === LanguageDetectionStage.Unknown ||
+  event.stage === LanguageDetectionStage.Error;
+
+/** Dò và chờ tới sự kiện kết thúc. */
+const detectUntilDone = (
+  connectionService: ReturnType<typeof makeMockConnectionService>,
+  draftPrinter: Printer,
+): Promise<LanguageDetectionEvent[]> =>
+  new Promise((resolve) => {
+    const events: LanguageDetectionEvent[] = [];
+    createLanguageDetectionService(connectionService).detect({ draftPrinter }, (event) => {
+      events.push(event);
+
+      if (isFinal(event)) {
+        resolve(events);
+      }
+    });
+  });
+
+/** Chờ các promise đang treo chạy xong. */
+const flush = (): Promise<void> => new Promise((resolve) => setTimeout(resolve, 0));
+
+describe('LanguageDetectionService', () => {
+  afterEach(() => jest.clearAllMocks());
+
+  it('TSPL trả lời lệnh dò → Detected TSPL, giữ kết nối, chỉ kết nối một lần', async () => {
+    const connectionService = makeMockConnectionService({ read: jest.fn().mockResolvedValue(TSPL_REPLY) });
+
+    const events = await detectUntilDone(connectionService, lanDraft);
+
+    expect(events.map((event) => event.stage)).toEqual([
+      LanguageDetectionStage.Connecting,
+      LanguageDetectionStage.Identifying,
+      LanguageDetectionStage.Detected,
+    ]);
+    expect(events[2]).toEqual({
+      stage: LanguageDetectionStage.Detected,
+      language: {
+        type: PrintLanguage.Tspl,
+        selection: LanguageSelection.Auto,
+        renderMode: RenderMode.Raster,
+        rasterSource: RasterSource.Image,
+      },
+    });
+    expect(connectionService.connect).toHaveBeenCalledTimes(1);
+    expect(connectionService.connect).toHaveBeenCalledWith(lanDraft);
+    expect(connectionService.send).toHaveBeenCalledWith(lanDraft.id, new Uint8Array([0x7e, 0x21, 0x54, 0x0d, 0x0a]));
+    expect(connectionService.disconnect).not.toHaveBeenCalled();
+    expect(PrinterLogger.languageDetected).toHaveBeenCalledWith(
+      expect.objectContaining({ language: PrintLanguage.Tspl, candidatesTried: [PrintLanguage.Tspl] }),
+    );
+  });
+
+  it('TSPL không trả lời, qua LAN thì xác nhận yếu ESC/POS trên cùng kết nối', async () => {
+    const connectionService = makeMockConnectionService();
+
+    const events = await detectUntilDone(connectionService, lanDraft);
+
+    expect(events[events.length - 1]).toEqual(
+      { stage: LanguageDetectionStage.Detected, language: expect.objectContaining({ type: PrintLanguage.EscPos }) },
+    );
+    expect(connectionService.connect).toHaveBeenCalledTimes(1);
+    expect(PrinterLogger.detectionCandidateRejected).toHaveBeenCalledWith(
+      expect.objectContaining({ language: PrintLanguage.Tspl, connectionType: ConnectionType.Lan }),
+    );
+  });
+
+  it('USB không bao giờ tự xác nhận ESC/POS → Unknown và ngắt kết nối', async () => {
+    const connectionService = makeMockConnectionService();
+
+    const events = await detectUntilDone(connectionService, usbDraft);
+
+    expect(events[events.length - 1]).toEqual({ stage: LanguageDetectionStage.Unknown });
+    expect(connectionService.disconnect).toHaveBeenCalledWith(usbDraft.id);
+    expect(PrinterLogger.languageUnknown).toHaveBeenCalledWith(
+      expect.objectContaining({ candidatesTried: [PrintLanguage.Tspl, PrintLanguage.EscPos] }),
+    );
+  });
+
+  it('in tem chỉ thử TSPL vì ESC/POS không in được tem', async () => {
+    const connectionService = makeMockConnectionService();
+
+    const events = await detectUntilDone(connectionService, { ...lanDraft, kind: PrintKind.Label });
+
+    expect(events.filter((event) => event.stage === LanguageDetectionStage.Identifying)).toEqual([
+      { stage: LanguageDetectionStage.Identifying, language: PrintLanguage.Tspl },
+    ]);
+    expect(events[events.length - 1]).toEqual({ stage: LanguageDetectionStage.Unknown });
+    expect(PrinterLogger.detectionStarted).toHaveBeenCalledWith(
+      expect.objectContaining({ candidates: [PrintLanguage.Tspl] }),
+    );
+  });
+
+  it('gửi lệnh dò lỗi thì coi như không khớp, thử ngôn ngữ tiếp theo', async () => {
+    const send = jest.fn().mockRejectedValue(new Error('write failed'));
+    const connectionService = makeMockConnectionService({ send });
+
+    const events = await detectUntilDone(connectionService, lanDraft);
+
+    expect(events[events.length - 1]).toEqual(
+      { stage: LanguageDetectionStage.Detected, language: expect.objectContaining({ type: PrintLanguage.EscPos }) },
+    );
+  });
+
+  it('không kết nối được → Error, ghi log detectionFailed', async () => {
+    const connectionService = makeMockConnectionService({ connect: jest.fn().mockRejectedValue(new Error('down')) });
+
+    const events = await detectUntilDone(connectionService, lanDraft);
+
+    expect(events[events.length - 1]).toEqual({
+      stage: LanguageDetectionStage.Error,
+      error: { code: PrinterErrorCode.PRINTER_CONNECTION_FAILED, message: 'Không thể kết nối tới máy in' },
+    });
+    expect(PrinterLogger.detectionFailed).toHaveBeenCalledWith(
+      expect.objectContaining({ printerId: lanDraft.id, connectionType: ConnectionType.Lan }),
+    );
+  });
+
+  it('huỷ trong lúc kết nối: kết nối xong thì ngắt, không báo thêm sự kiện', async () => {
+    let finishConnect: () => void = () => undefined;
+    const connectionService = makeMockConnectionService({
+      connect: jest.fn().mockImplementation(() => new Promise<void>((resolve) => (finishConnect = resolve))),
+    });
+    const events: LanguageDetectionEvent[] = [];
+
+    const unsubscribe = createLanguageDetectionService(connectionService).detect({ draftPrinter: lanDraft }, (event) =>
+      events.push(event),
+    );
+    unsubscribe();
+    finishConnect();
+    await flush();
+
+    expect(events.map((event) => event.stage)).toEqual([LanguageDetectionStage.Connecting]);
+    expect(connectionService.send).not.toHaveBeenCalled();
+    expect(connectionService.disconnect).toHaveBeenCalledWith(lanDraft.id);
+  });
+
+  it('huỷ trong lúc chờ phản hồi lệnh dò: ngắt kết nối, không báo Detected', async () => {
+    let reply: (response: Uint8Array | null) => void = () => undefined;
+    const connectionService = makeMockConnectionService({
+      read: jest.fn().mockImplementation(() => new Promise((resolve) => (reply = resolve))),
+    });
+    const events: LanguageDetectionEvent[] = [];
+
+    const unsubscribe = createLanguageDetectionService(connectionService).detect({ draftPrinter: lanDraft }, (event) =>
+      events.push(event),
+    );
+    await flush();
+    unsubscribe();
+    reply(TSPL_REPLY);
+    await flush();
+
+    expect(events.map((event) => event.stage)).toEqual([
+      LanguageDetectionStage.Connecting,
+      LanguageDetectionStage.Identifying,
+    ]);
+    expect(connectionService.disconnect).toHaveBeenCalledWith(lanDraft.id);
+  });
+});
